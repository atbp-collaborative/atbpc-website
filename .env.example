# Supabase Project URL
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"

# Supabase Anonymous Public Key (Safe for browser/client use, governed by Row Level Security)
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Supabase Service Role Key (Keep secret! Only for server-side/admin operations, never expose to client)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Data Source Toggle ('supabase' | 'mock')
NEXT_PUBLIC_DATA_SOURCE="supabase"

# Development Gate Pass (Set to false to enforce live Supabase Auth & Passkey check)
NEXT_PUBLIC_GATE_PASS="true"

# Master Turnover Secret Code for Initial Superadmin Onboarding Ceremony
ADMIN_TURNOVER_CODE="12181993"
