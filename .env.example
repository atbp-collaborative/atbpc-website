# ==============================================================================
# ATBP COLLABORATIVE - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to '.env.local' on your new workstation:
#   cp .env.example .env.local
# Then fill in the required keys below.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE CONNECTION & CREDENTIALS (REQUIRED)
# ------------------------------------------------------------------------------
# Project URL from Supabase Dashboard (Settings -> API -> Project URL)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"

# Anonymous Public Key (Safe for browser/client use, governed by Row Level Security)
# Supabase Dashboard (Settings -> API -> Project API keys -> 'anon' / 'public')
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key-here"

# Service Role Secret Key (Keep strictly secret! Never expose to client/browser)
# Supabase Dashboard (Settings -> API -> Project API keys -> 'service_role')
# Required for running 'npm run seed:storage', administrative operations, and user creation
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key-here"

# ------------------------------------------------------------------------------
# 2. RUNTIME FEATURE & SECURITY TOGGLES
# ------------------------------------------------------------------------------
# Data Source: 'supabase' (live PostgreSQL database) | 'mock' (in-memory fallback)
NEXT_PUBLIC_DATA_SOURCE="supabase"

# Development Gate Pass:
# - Set to "false" to enforce live Supabase Authentication, RBAC, and WebAuthn Passkeys.
# - Set to "true" ONLY for offline UI development or testing without Supabase Auth.
NEXT_PUBLIC_GATE_PASS="false"

# Maintenance Mode Flag ('true' | 'false')
MAINTENANCE_MODE="false"

# Base Application URL (Used for email callback redirects, sitemaps, and metadata)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 3. ONBOARDING & CEREMONY SECRETS
# ------------------------------------------------------------------------------
# Master Secret Passcode required for the Initial Superadmin Onboarding Ceremony
# Navigated via: /admin/login/turn-over
ADMIN_TURNOVER_CODE="12181993"

# ------------------------------------------------------------------------------
# 4. RESEND EMAIL INTEGRATION (TRANSACTIONAL NOTIFICATIONS)
# ------------------------------------------------------------------------------
# NOTICE: The previous Resend API key is lost / deprecated.
# Outgoing email dispatchers (/api/send, /api/career/send, /api/discovery/send,
# /api/partner/send, /api/proposal/send) require an active Resend API key.
#
# To restore email functionality:
#   1. Sign in or register at https://resend.com/api-keys
#   2. Create an API key with 'Sending access' (or full access).
#   3. Paste the 're_...' key below.
#
# If left empty, API routes will log errors upon submission, but public form
# validation and user UX will remain accessible.
RESEND_API_KEY=""

# The studio notification destination inbox (where form submissions are delivered)
# Note: For free Resend sandbox accounts, use your verified Resend account email.
# For production, verify your company domain (e.g., inquiry@atbpcollaborative.com).
COMPANY_EMAIL="inquiry@atbpcollaborative.com"
